# Groq Cloud API Key (Get from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Database connection URL
# SQLite default: sqlite+aiosqlite:///./dentalsim.db
# PostgreSQL default: postgresql+asyncpg://user:password@localhost:5432/dentalsim
DATABASE_URL=sqlite+aiosqlite:///./dentalsim.db

# Redis connection (optional)
# REDIS_URL=redis://localhost:6379

# Security Settings
JWT_SECRET=generate_a_secure_random_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Simulation settings
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.65
LLM_MAX_TOKENS=150
